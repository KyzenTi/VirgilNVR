# Porta do servidor HTTP (padrão 3000)
PORT=3000

# Diretório local onde o banco SQLite será armazenado
DATA_DIR=./data

# Diretório raiz local para gravações de vídeo (no LXC: /opt/vigilnvr/recordings)
STORAGE_ROOT=./recordings

# Política de retenção padrão
RETENTION_DAYS=90
MAX_DISK_PERCENT=85

# Permissões padrão para usuários do grupo viewers ("true" libera todos os canais ativos se não houver restrição)
VIEWER_DEFAULT_ALL_CHANNELS=true

# Binários locais do FFmpeg e FFprobe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Senha inicial opcional do administrador (se vazio, o primeiro acesso exibe tela de configuração do admin)
ADMIN_INITIAL_PASSWORD=

# URL da aplicação (injetada em produção / proxy local)
APP_URL=http://localhost:3000
